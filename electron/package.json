{
  "name": "smshub-desktop",
  "version": "0.1.77",
  "description": "SMSHub Desktop — Real-time SMS messaging",
  "main": "dist/main/entry.js",
  "author": "SMSHub",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "package:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml",
    "package:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "package:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "ci:package:linux": "electron-vite build && electron-builder --linux AppImage --config electron-builder.yml --publish never",
    "ci:package:mac": "electron-vite build && electron-builder --mac dmg --config electron-builder.yml --publish never",
    "ci:package:win": "electron-vite build && electron-builder --win nsis --config electron-builder.yml --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5"
  },
  "pnpm": {
    "overrides": {
      "@tootallnate/once@<2.0.1": "2.0.1",
      "@xmldom/xmldom@<0.8.13": "0.8.13",
      "ip-address@<=10.1.0": "10.2.0",
      "lodash@<=4.17.23": "4.18.1",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.10": "8.5.15",
      "tmp@<0.2.6": "0.2.7"
    }
  }
}
