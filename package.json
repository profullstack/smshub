{
  "name": "smshub",
  "version": "0.1.171",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint src/",
    "test": "bun --bun vitest run",
    "test:e2e": "playwright test",
    "test:watch": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "version:patch": "bash scripts/version.sh patch",
    "version:minor": "bash scripts/version.sh minor",
    "version:major": "bash scripts/version.sh major",
    "version:set": "bash scripts/version.sh"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@profullstack/affiliates": "^0.3.0",
    "@profullstack/coinpay-onboard": "0.3.1",
    "@profullstack/footer": "latest",
    "@profullstack/profile": "0.1.6",
    "@profullstack/redeem-credits": "^0.2.0",
    "@profullstack/referrals": "^0.1.0",
    "@profullstack/stack": "^0.5.0",
    "@profullstack/throttle": "^0.4.1",
    "@profullstack/webhooks": "0.2.1",
    "@profullstack/x402-gateway": "^0.16.1",
    "@sentry/nextjs": "^11.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
