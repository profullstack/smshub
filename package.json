{
  "name": "smshub",
  "version": "0.1.112",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint src/",
    "test": "bun --bun vitest run",
    "test:e2e": "playwright test",
    "test:watch": "bun --bun vitest",
    "test:coverage": "bun --bun vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "version:patch": "bash scripts/version.sh patch",
    "version:minor": "bash scripts/version.sh minor",
    "version:major": "bash scripts/version.sh major",
    "version:set": "bash scripts/version.sh"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@profullstack/referrals": "^0.1.0",
    "@profullstack/stack": "^0.1.3",
    "@profullstack/x402-gateway": "^0.7.0",
    "@sentry/nextjs": "^10.56.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.107.0",
    "next": "16.3.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "bun@1.4.0",
  "overrides": {
    "brace-expansion@<1.1.13": "1.1.13",
    "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
    "brace-expansion@>=4.0.0 <5.0.5": "5.0.6",
    "brace-expansion@>=5.0.0 <5.0.6": "5.0.6",
    "picomatch@<2.3.2": "2.3.2",
    "picomatch@>=4.0.0 <4.0.4": "4.0.4",
    "postcss@<8.5.10": "8.5.15",
    "uuid@<11.1.1": "14.0.0",
    "vite@>=8.0.0 <=8.0.4": "8.0.5",
    "yaml@>=2.0.0 <2.8.3": "2.9.0"
  }
}
